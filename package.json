{
  "name": "paladex",
  "version": "0.1.0",
  "private": true,
  "description": "Paladex: the 3D padel racket database. Discover, inspect, compare and choose padel rackets in 3D.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "setup": "tsx scripts/setup-env.ts && npm run db:migrate && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts && npm run setup",
    "db:studio": "drizzle-kit studio",
    "models:optimize": "tsx scripts/optimize-model.ts",
    "assets:decoders": "tsx scripts/copy-decoders.ts",
    "admin:hash": "tsx scripts/hash-admin-password.ts",
    "test": "tsx --test src/**/*.test.ts",
    "postinstall": "tsx scripts/copy-decoders.ts",
    "models:trace": "tsx scripts/trace-racket-photo.ts",
    "models:build": "tsx scripts/generate-models.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "aws4fetch": "1.0.20",
    "camera-controls": "3.1.2",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@types/three": "0.186.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "meshoptimizer": "1.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
