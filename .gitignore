# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
# Node
node_modules/
# frontend/dist is committed so the app runs with Python only (rebuild with: cd frontend && npm run build)
# Local data (never commit the father's database or API keys)
data/
*.sqlite3
*.db
.env
# a key file left half-written by the app (envfile.py writes .env.<random> then renames it)
.env.*
!.env.example
# the owner's local opt-out of automatic updates (committing it would stop every installation updating)
.no-auto-update
*.tsbuildinfo
# Read-only online copy (scripts/mirror): Netlify CLI state and local build output
.netlify/
mirror-out/
