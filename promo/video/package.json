{
  "name": "paladex-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Paladex launch ad, built with Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "voice": "python audio/make_vo.py",
    "music": "python audio/make_music.py",
    "render": "remotion render PaladexLaunch out/paladex-launch-en.mp4",
    "render:nosubs": "remotion render PaladexLaunch out/paladex-launch-en-nosubs.mp4 --props={\"lang\":\"en\",\"subtitles\":false,\"music\":true}",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.533",
    "@remotion/effects": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/media-utils": "4.0.533",
    "@remotion/motion-blur": "4.0.533",
    "@remotion/noise": "4.0.533",
    "@remotion/three": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.533",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
