# Copy to .env.local for local development (`npm run setup` does this for you
# and fills in the admin secrets). Never commit real values.

# --------------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search engines are asked NOT to index the site until this is "true".
# Keep it false while the catalog contains sample data.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ----------------------------------------------------------------- database
# Local: a SQLite file created by `npm run setup`.
# Production: Turso (libsql://<db>-<org>.turso.io) plus an auth token,
# or a file path on a host with a persistent disk.
DATABASE_URL=file:./data/paladex.db
DATABASE_AUTH_TOKEN=

# -------------------------------------------------------------------- admin
# scrypt hash of the admin password. Generate with:
#   npm run admin:hash -- "a-long-unique-password"
ADMIN_PASSWORD_HASH=
# 32+ random characters used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------- assets
# Where admin uploads (GLB/GLTF models, posters, images) are stored:
#   local -> public/uploads (development or a server with a persistent disk)
#   s3    -> any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2...)
ASSET_STORAGE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket, e.g. https://assets.example.com
S3_PUBLIC_BASE_URL=
# Extra origins allowed to serve models and images (comma separated).
# Add your bucket/CDN origin here so the CSP and next/image accept it.
ASSET_ORIGINS=

# ---------------------------------------------------------------- analytics
# none | console | first-party | plausible
#   first-party: events are stored in the local database (no cookies, no IPs)
NEXT_PUBLIC_ANALYTICS_PROVIDER=first-party
# Only for plausible:
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_ORIGIN=
