# Copy this file to ".env" (same folder) and fill in the keys you have.
# Every key is optional: without it, that source/feature is skipped and the app says so.

# --- AI (summaries, translation, assistant, daily briefing) ---
# Provider: "anthropic", "openai" or "none"
PALADEX_LLM_PROVIDER=none
PALADEX_ANTHROPIC_API_KEY=
PALADEX_ANTHROPIC_MODEL=claude-sonnet-5-5
PALADEX_OPENAI_API_KEY=
PALADEX_OPENAI_MODEL=gpt-4o-mini

# --- Data sources ---
# UN Comtrade free subscription key (https://comtradedeveloper.un.org) — without it the
# public preview endpoint is used (max 500 rows per call, annual data only in practice).
PALADEX_COMTRADE_API_KEY=
# USDA AMS MyMarketNews API key: not used at present (the National Honey Report is read from its PDF).
PALADEX_USDA_MMN_API_KEY=
# api.data.gov key (free, https://api.data.gov/signup/) — USDA FAS GATS: monthly US honey
# imports by origin from US Census (quantity, value, unit value)
PALADEX_DATA_GOV_API_KEY=
# USDA NASS Quick Stats key (free, https://quickstats.nass.usda.gov/api)
PALADEX_USDA_NASS_API_KEY=
# US Census Bureau API key (free, https://api.census.gov/data/key_signup.html). Optional: monthly
# US honey imports by origin straight from Census (same data as GATS, plus CIF, duty and world total).
# Without a key the collector still runs within Census's daily keyless limit.
# PALADEX_CENSUS_API_KEY=
# FAOSTAT Developer Portal account (free, https://www.fao.org/faostat/en/#developer-portal).
# Optional: without it FAOSTAT honey data comes from the public bulk downloads (no account needed).
# With it, the app uses small API queries instead of the large files and also loads bilateral
# honey trade (who ships honey to whom). Use the account e-mail as user name.
# PALADEX_FAOSTAT_USERNAME=
# PALADEX_FAOSTAT_PASSWORD=

# --- App ---
PALADEX_PORT=8765
# Where the database and downloaded reports are stored (default: ./data next to the app)
# PALADEX_DATA_DIR=
# Turn automatic background collection on/off
PALADEX_SCHEDULER_ENABLED=true
# Automatic update of the program at every start (git); false turns it off
# PALADEX_AUTO_UPDATE=true
# Name shown on the corrections made on this computer ("corretto da ..."); it can also be chosen on screen
# PALADEX_USER_NAME=Utente
# Exchange corrections with the owner's other computers through the git branch paladex-corrections.
# Off unless switched on (on screen, or true here) on each computer; how often, in minutes
# PALADEX_CORRECTIONS_SYNC=false
# PALADEX_CORRECTIONS_SYNC_MINUTES=15
